  "keyFeatures": [
    "Complete CLOB (Central Limit Order Book) integration with L1/L2 methods",
    "Real-time WebSocket support for market data, user orders, and trades",
    "EVM smart contract interactions (CTF, CTF Exchange, ERC20)",
    "EIP-712 signature support for secure order signing",
    "Real-Time Data Socket (RTDS) for crypto price feeds",
    "Type-safe order and trade management",
    "Automatic reconnection and heartbeat for WebSocket connections",
    "Support for multiple signature types (EOA, Proxy, Gnosis Safe)"
  ],
  "publicApiSurface": [
    "newPolycule(signerKey, config, signatureType) -> PolyculeClient",
    "setMarket(client, marketSlug)",
    "buy(client, outcomeYes, size, price, postOrderOptions) -> OrderResponse",
    "sell(client, outcomeYes, size, price, postOrderOptions) -> OrderResponse",
    "createAndPostOrder(client, order, createOptions, postOptions) -> OrderResponse",
    "cancelOrder(client, orderID) -> CancelOrdersResponse",
    "getOpenOrders(client, params) -> OpenOrdersResponse",
    "getTrades(client, params) -> seq[TradeResponse]",
    "getOrderBook(tokenID) -> OrderBookSummary",
    "MarketWss.connect(assetIds, customFeatures, config) -> MarketWss",
    "UserWss.connect(marketIds, creds, customFeatures, config) -> UserWss",
    "Rtds.connect(subscriptions, config) -> Rtds",
    "listenToMarketWss(client)",
    "listenToUserWss(client)",
    "listenToRtds(client)",
    "subscribe(ws, topic, msgType, filters)",
    "getMarket(slug, includeTag) -> GammaMarketResponse",
    "approveCollateral(client, amount) -> bool",
    "depositCollateral(client, amount) -> bool",
    "getCryptoCurrentMarketSlug(symbol, timeframe) -> string"
  ]
}
